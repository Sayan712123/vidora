<?xml version="1.0" encoding="utf-8"?>
<!--
  Vidora adaptive-icon foreground.

  Drawn as a vector so it stays razor sharp at every density and adds almost nothing
  to the APK. The mark is original to this project: a coral play triangle whose right
  edge lifts into an amber light streak.

  The artwork sits inside the middle ~66dp of the 108dp canvas, which keeps it clear
  of every launcher mask (circle, squircle, rounded square, teardrop).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Play triangle. The round-joined stroke is what rounds the three corners. -->
    <path
        android:fillColor="#FF7A45"
        android:strokeColor="#FF7A45"
        android:strokeWidth="7"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M42,43 L42,65 L67,54 Z" />

    <!-- Light streak lifting off the apex. -->
    <path
        android:strokeColor="#FFB347"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M63,50.5 C69,47 73.5,42.5 76.5,36.5" />

    <!-- A soft inner highlight on the triangle for depth. -->
    <path
        android:fillColor="#FF9A5C"
        android:fillAlpha="0.55"
        android:pathData="M44.5,46.5 L44.5,61.5 L58,54 Z" />
</vector>
